<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Zeiterfassung</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      padding: 20px;
    }
    .header {
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .header h1 {
      color: #333;
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .nav-link {
      padding: 10px 20px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    .nav-link:hover {
      background: #5568d3;
    }
    .todo-btn {
      padding: 10px 20px;
      background: #28a745;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    .todo-btn:hover {
      background: #218838;
    }
    .logout-btn {
      padding: 10px 20px;
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    .logout-btn:hover {
      background: #c82333;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
    }
    .card {
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      margin-bottom: 20px;
    }
    .card h2 {
      margin-bottom: 20px;
      color: #333;
    }
    .form-group {
      margin-bottom: 20px;
    }
    label {
      display: block;
      margin-bottom: 5px;
      color: #555;
      font-weight: bold;
    }
    input, textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 14px;
    }
    textarea {
      min-height: 80px;
      resize: vertical;
      font-family: Arial, sans-serif;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #667eea;
    }
    .button-group {
      display: flex;
      gap: 10px;
    }
    button {
      padding: 12px 30px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.3s;
    }
    button:hover {
      background: #5568d3;
    }
    .feierabend-btn {
      background: #28a745;
      font-size: 18px;
      font-weight: bold;
    }
    .feierabend-btn:hover {
      background: #218838;
    }
    .success-message {
      background: #d4edda;
      color: #155724;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
      border: 1px solid #c3e6cb;
      display: none;
    }
    .error-message {
      background: #f8d7da;
      color: #721c24;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
      border: 1px solid #f5c6cb;
      display: none;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background: #667eea;
      color: white;
      font-weight: bold;
    }
    tr:hover {
      background: #f5f5f5;
    }
    #tasksTable {
      display: none;
    }
    .no-tasks {
      text-align: center;
      color: #999;
      padding: 20px;
      font-style: italic;
    }
    .total-row {
      font-weight: bold;
      background: #e9ecef !important;
    }
    /* Modal styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.4);
    }
    .modal-content {
      background-color: #fefefe;
      margin: 5% auto;
      padding: 0;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      width: 90%;
      max-width: 800px;
      max-height: 80vh;
      overflow-y: auto;
    }
    .modal-header {
      padding: 20px;
      background: #667eea;
      color: white;
      border-radius: 10px 10px 0 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h2 {
      margin: 0;
    }
    .modal-body {
      padding: 20px;
    }
    .close {
      color: white;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      line-height: 1;
    }
    .close:hover,
    .close:focus {
      color: #f5f5f5;
    }
    .todo-item {
      background: white;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 15px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }
    .todo-item.done {
      background: #f8f9fa;
      opacity: 0.7;
    }
    .todo-item.done .todo-title {
      text-decoration: line-through;
    }
    .todo-content {
      flex: 1;
    }
    .todo-title {
      font-weight: bold;
      margin-bottom: 5px;
      color: #333;
    }
    .todo-description {
      color: #666;
      font-size: 14px;
    }
    .todo-actions {
      display: flex;
      gap: 5px;
    }
    .btn-small {
      padding: 5px 10px;
      font-size: 12px;
    }
    .btn-success {
      background: #28a745;
    }
    .btn-success:hover {
      background: #218838;
    }
    .btn-warning {
      background: #ffc107;
      color: #333;
    }
    .btn-warning:hover {
      background: #e0a800;
    }
    .btn-danger {
      background: #dc3545;
    }
    .btn-danger:hover {
      background: #c82333;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>⏱️ Zeiterfassung</h1>
      <div class="user-info">
        <button class="todo-btn" aria-label="Open ToDo management modal" onclick="openTodoModal()">📝 ToDos</button>
        <a href="/all-entries" class="nav-link">Alle Einträge</a>
        <span>Willkommen, <strong><%= username %></strong></span>
        <a href="/logout" class="logout-btn">Abmelden</a>
      </div>
    </div>

    <div class="card">
      <h2>Erfassen Sie Ihre Zeit</h2>
      <div id="successMessage" class="success-message"></div>
      <div id="errorMessage" class="error-message"></div>
      
      <form id="taskForm">
        <div class="form-group">
          <label for="taskName">Aufgabenname *</label>
          <input type="text" id="taskName" name="taskName" required>
        </div>
        <div class="form-group">
          <label for="customerName">Kundenname *</label>
          <input type="text" id="customerName" name="customerName" required>
        </div>
        <div class="form-group">
          <label for="description">Beschreibung</label>
          <textarea id="description" name="description"></textarea>
        </div>
        <div class="form-group">
          <label>Dauer *</label>
          <div style="display: flex; gap: 10px; align-items: center;">
            <div style="flex: 1;">
              <input type="number" id="hours" name="hours" min="0" value="0" style="width: 100%;">
              <small style="color: #666;">Stunden</small>
            </div>
            <div style="flex: 1;">
              <input type="number" id="minutes" name="minutes" min="0" max="59" value="0" style="width: 100%;">
              <small style="color: #666;">Minuten</small>
            </div>
          </div>
        </div>
        <div class="button-group">
          <button type="submit">Aufgabe hinzufügen</button>
          <button type="button" class="feierabend-btn" onclick="showFeierabend()">Feierabend</button>
        </div>
      </form>
    </div>

    <div class="card" id="tasksTable">
      <h2>Heutige Aufgaben</h2>
      <div class="form-group" id="searchContainer" style="display: none;">
        <label for="searchInput">Aufgaben suchen</label>
        <input type="text" id="searchInput" placeholder="Suchen Sie nach Aufgabenname, Kunde oder Beschreibung...">
      </div>
      <div id="tasksContainer"></div>
    </div>
  </div>

  <!-- ToDo Modal -->
  <div id="todoModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>📝 ToDo Liste</h2>
        <button class="close" type="button" aria-label="Close modal" onclick="closeTodoModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="card" style="margin: 0; box-shadow: none;">
          <h3>Neues ToDo hinzufügen</h3>
          <form id="todoForm">
            <div class="form-group">
              <label for="todoTitle">Titel *</label>
              <input type="text" id="todoTitle" name="todoTitle" required>
            </div>
            <div class="form-group">
              <label for="todoDescription">Beschreibung</label>
              <textarea id="todoDescription" name="todoDescription"></textarea>
            </div>
            <button type="submit">ToDo hinzufügen</button>
          </form>
        </div>
        
        <div class="card" style="margin-top: 20px; box-shadow: none;">
          <h3>Meine ToDos</h3>
          <div id="todoList"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let allTasks = []; // Store all tasks for search filtering

    document.getElementById('taskForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const hours = parseInt(document.getElementById('hours').value) || 0;
      const minutes = parseInt(document.getElementById('minutes').value) || 0;
      
      if (hours === 0 && minutes === 0) {
        showError('Dauer muss größer als 0 sein');
        return;
      }
      
      const formData = {
        taskName: document.getElementById('taskName').value,
        customerName: document.getElementById('customerName').value,
        description: document.getElementById('description').value,
        hours: hours,
        minutes: minutes
      };

      try {
        const response = await fetch('/add-task', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (data.success) {
          const durationHours = Math.floor(data.task.duration / 60);
          const durationMinutes = data.task.duration % 60;
          showSuccess(`Aufgabe "${data.task.taskName}" für Kunde "${data.task.customerName}" hinzugefügt! Dauer: ${durationHours}h ${durationMinutes}m, Start: ${data.task.startTime}, Ende: ${data.task.endTime}`);
          // Reload the page to update the table
          window.location.reload();
        } else {
          showError(data.error || 'Aufgabe konnte nicht hinzugefügt werden');
        }
      } catch (error) {
        showError('Aufgabe konnte nicht hinzugefügt werden');
      }
    });

    async function showFeierabend() {
      try {
        const response = await fetch('/feierabend');
        const data = await response.json();

        if (data.tasks && data.tasks.length > 0) {
          allTasks = data.tasks;
          displayTasks(allTasks);
          document.getElementById('searchContainer').style.display = 'block';
        } else {
          displayNoTasks();
          document.getElementById('searchContainer').style.display = 'none';
        }
      } catch (error) {
        showError('Aufgaben konnten nicht geladen werden');
      }
    }

    // Search functionality
    document.getElementById('searchInput').addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase();
      const filteredTasks = allTasks.filter(task => {
        return (
          task.task_name.toLowerCase().includes(searchTerm) ||
          (task.customer_name && task.customer_name.toLowerCase().includes(searchTerm)) ||
          (task.description && task.description.toLowerCase().includes(searchTerm))
        );
      });
      displayTasks(filteredTasks);
    });

    function displayTasks(tasks) {
      let totalMinutes = 0;
      let html = '<table><thead><tr><th>Aufgabenname</th><th>Kunde</th><th>Beschreibung</th><th>Dauer</th><th>Startzeit</th><th>Endzeit</th></tr></thead><tbody>';
      
      tasks.forEach(task => {
        totalMinutes += task.duration;
        const hours = Math.floor(task.duration / 60);
        const minutes = task.duration % 60;
        html += `
          <tr>
            <td>${escapeHtml(task.task_name)}</td>
            <td>${escapeHtml(task.customer_name || '-')}</td>
            <td>${escapeHtml(task.description || '-')}</td>
            <td>${hours}h ${minutes}m</td>
            <td>${escapeHtml(task.start_time)}</td>
            <td>${escapeHtml(task.end_time)}</td>
          </tr>
        `;
      });

      const totalHours = Math.floor(totalMinutes / 60);
      const totalMins = totalMinutes % 60;
      html += `
        <tr class="total-row">
          <td colspan="3">Gesamt</td>
          <td>${totalHours}h ${totalMins}m</td>
          <td colspan="2"></td>
        </tr>
      `;
      html += '</tbody></table>';
      
      document.getElementById('tasksContainer').innerHTML = html;
      document.getElementById('tasksTable').style.display = 'block';
    }

    function displayNoTasks() {
      document.getElementById('tasksContainer').innerHTML = '<div class="no-tasks">Keine Aufgaben für heute gefunden</div>';
      document.getElementById('tasksTable').style.display = 'block';
    }

    function showSuccess(message) {
      const elem = document.getElementById('successMessage');
      elem.textContent = message;
      elem.style.display = 'block';
      setTimeout(() => elem.style.display = 'none', 5000);
    }

    function showError(message) {
      const elem = document.getElementById('errorMessage');
      elem.textContent = message;
      elem.style.display = 'block';
      setTimeout(() => elem.style.display = 'none', 5000);
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ToDo Modal Functions
    let allTodos = [];

    function openTodoModal() {
      document.getElementById('todoModal').style.display = 'block';
      loadTodos();
    }

    function closeTodoModal() {
      document.getElementById('todoModal').style.display = 'none';
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
      const modal = document.getElementById('todoModal');
      if (event.target === modal) {
        closeTodoModal();
      }
    }

    // Load all todos
    async function loadTodos() {
      try {
        const response = await fetch('/api/todos');
        const data = await response.json();
        
        if (data.todos) {
          allTodos = data.todos;
          displayTodos(allTodos);
        }
      } catch (error) {
        console.error('Error loading todos:', error);
        showError('ToDos konnten nicht geladen werden');
      }
    }

    // Display todos
    function displayTodos(todos) {
      const container = document.getElementById('todoList');
      
      if (todos.length === 0) {
        container.innerHTML = '<div class="no-tasks">Keine ToDos vorhanden</div>';
        return;
      }
      
      let html = '';
      todos.forEach(todo => {
        const doneClass = todo.done ? 'done' : '';
        html += `
          <div class="todo-item ${doneClass}">
            <div class="todo-content">
              <div class="todo-title">${escapeHtml(todo.title)}</div>
              ${todo.description ? `<div class="todo-description">${escapeHtml(todo.description)}</div>` : ''}
            </div>
            <div class="todo-actions">
              ${!todo.done ? `<button class="btn-small btn-success" onclick="toggleTodo(${todo.id}, true)">✓ Erledigt</button>` : `<button class="btn-small btn-warning" onclick="toggleTodo(${todo.id}, false)">↺ Wiederherstellen</button>`}
              <button class="btn-small btn-warning" onclick="convertToTask(${todo.id})">→ Zu Aufgabe</button>
              <button class="btn-small btn-danger" onclick="deleteTodo(${todo.id})">✗</button>
            </div>
          </div>
        `;
      });
      
      container.innerHTML = html;
    }

    // Add new todo
    document.getElementById('todoForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = {
        title: document.getElementById('todoTitle').value.trim(),
        description: document.getElementById('todoDescription').value.trim()
      };

      try {
        const response = await fetch('/api/todos', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (data.success) {
          document.getElementById('todoForm').reset();
          loadTodos();
          showSuccess('ToDo hinzugefügt');
        } else {
          showError(data.error || 'ToDo konnte nicht hinzugefügt werden');
        }
      } catch (error) {
        showError('ToDo konnte nicht hinzugefügt werden');
      }
    });

    // Toggle todo done status
    async function toggleTodo(id, done) {
      try {
        const response = await fetch(`/api/todos/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ done })
        });

        const data = await response.json();

        if (data.success) {
          loadTodos();
        } else {
          showError(data.error || 'ToDo konnte nicht aktualisiert werden');
        }
      } catch (error) {
        showError('ToDo konnte nicht aktualisiert werden');
      }
    }

    // Delete todo
    async function deleteTodo(id) {
      if (!confirm('Möchten Sie dieses ToDo wirklich löschen?')) {
        return;
      }

      try {
        const response = await fetch(`/api/todos/${id}`, {
          method: 'DELETE'
        });

        const data = await response.json();

        if (data.success) {
          loadTodos();
          showSuccess('ToDo gelöscht');
        } else {
          showError(data.error || 'ToDo konnte nicht gelöscht werden');
        }
      } catch (error) {
        showError('ToDo konnte nicht gelöscht werden');
      }
    }

    // Convert todo to task
    async function convertToTask(id) {
      const todo = allTodos.find(t => t.id === id);
      if (!todo) return;
      
      // Pre-fill the task form with todo data
      document.getElementById('taskName').value = todo.title;
      document.getElementById('description').value = todo.description || '';
      
      // Close modal and scroll to form
      closeTodoModal();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      
      // Optional: Mark todo as done after converting
      await toggleTodo(id, true);
    }
  </script>
</body>
</html>
